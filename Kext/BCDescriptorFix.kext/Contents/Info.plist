	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>IOKitPersonalities</key>
	<dict>
		<!--
		Codeless personality. AppleUSBHostMergeProperties merges IOProviderMergeProperties
		into the IOUSBHostDevice before the composite driver reads the configuration.
		The descriptor below is the BCR2000's own 101-byte configuration descriptor with
		one byte changed: bulk OUT endpoint 0x02 wMaxPacketSize 4 -> 8 (offset 91).
		Apple's xHCI stack rejects 4; USB 2.0 §5.8.3 permits 8, 16, 32, or 64.
		-->
		<key>Behringer BCR2000 bulk OUT wMaxPacketSize fix</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>com.apple.driver.AppleUSBHostMergeProperties</string>
			<key>IOClass</key>
			<string>AppleUSBHostMergeProperties</string>
			<key>IOProviderClass</key>
			<string>IOUSBHostDevice</string>
			<key>IOProviderMergeProperties</key>
			<dict>
				<key>kUSBDescriptorOverride</key>
				<dict>
					<key>descriptor</key>
					<data>
					CQJlAAIBAEAACQQAAAABAQAACSQBAAEJAAEBCQQBAAIBAwAAByQBAAFBAAYkAgEBAAYkAgICAAkkAwED
					AQIBAAkkAwIEAQEBAAkFgQJAAAAAAAUlAQEDCQUCAggAAAAABSUBAQE=
					</data>
					<key>index</key>
					<integer>0</integer>
					<key>languageID</key>
					<integer>0</integer>
				</dict>
			</dict>
			<key>idVendor</key>
			<integer>5015</integer>
			<key>idProduct</key>
			<integer>188</integer>
		</dict>
	</dict>
	<key>OSBundleLibraries</key>
	<dict>
		<key>com.apple.driver.AppleUSBHostMergeProperties</key>
		<string>1.2</string>
	</dict>
	<key>OSBundleRequired</key>
	<string>Root</string>
</dict>
</plist>
